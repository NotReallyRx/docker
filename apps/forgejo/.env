# ---------------------------------------------------------------------------
# Forgejo + MySQL configuration
# Copy this file to `.env` next to docker-compose.yml. docker compose
# loads it automatically.
# ---------------------------------------------------------------------------

# --- Storage ---
# Parent folder holding forgejo/ and mysql/ subfolders (see README)
CONFIG_ROOT=

# --- Versions ---
FORGEJO_VERSION=14
MYSQL_VERSION=8

# --- Forgejo ---
FORGEJO_UID=1000
FORGEJO_GID=1000
WEB_PORT=5000
SSH_PORT=223
SSH_DOMAIN=

# --- Database (REQUIRED) --- 
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Please pick good passwords I beg