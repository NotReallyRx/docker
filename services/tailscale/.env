
# --- Tailscale (REQUIRED) ---
# Generate an auth key (ephemeral/reusable as needed) from:
# https://console.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=

CONFIG_ROOT=
# something like /home/user/config/
# NOT /home/user/config/ts because if u set config_root to that the config folder would be /home/user/config/ts/ts